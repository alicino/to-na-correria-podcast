---
const year = new Date().getFullYear();
---

<footer class="bg-gray-50 dark:bg-[#0d0d0d] border-t border-gray-100 dark:border-gray-800 mt-16 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
      <!-- Brand -->
      <div class="flex flex-col items-center md:items-start gap-3">
        <a href="/" class="flex items-center gap-2">
          <img src="/img/podcast-logo.png" alt="Tô na Correria Podcast" class="h-10 w-auto" />
        </a>
        <p class="text-sm text-gray-500 dark:text-gray-400 text-center md:text-left max-w-xs">
          Podcast brasileiro sobre corrida de rua gravado em Austin, Texas.
        </p>
      </div>

      <!-- Links -->
      <div class="flex flex-col items-center gap-2">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1">Páginas</h3>
        <nav class="flex flex-col items-center gap-1.5">
          <a href="/" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">Home</a>
          <a href="/sobre" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">Sobre Nós</a>
          <a href="/episodios" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">Episódios</a>
          <a href="/eventos" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">Eventos</a>
          <a href="/ouca" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">Ouça o Podcast</a>
        </nav>
      </div>

      <!-- Social -->
      <div class="flex flex-col items-center md:items-end gap-3">
        <h3 class="text-sm font-semibold text-gray-700 dark:text-gray-300 uppercase tracking-wider mb-1">Redes Sociais</h3>
        <div class="flex items-center gap-3">
          <!-- Instagram -->
          <a
            href="https://www.instagram.com/tonacorreriapodcast/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="p-2 rounded-lg text-gray-400 hover:text-primary dark:hover:text-primary hover:bg-primary/10 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <!-- Facebook -->
          <a
            href="https://www.facebook.com/tonacorreriapodcast"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="p-2 rounded-lg text-gray-400 hover:text-primary dark:hover:text-primary hover:bg-primary/10 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <!-- Strava -->
          <a
            href="https://www.strava.com/clubs/986647"
            target="_blank"
            rel="noopener"
            aria-label="Strava"
            class="p-2 rounded-lg text-gray-400 hover:text-primary dark:hover:text-primary hover:bg-primary/10 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
            </svg>
          </a>
          <!-- RSS -->
          <a
            href="https://anchor.fm/s/6d5ec654/podcast/rss"
            target="_blank"
            rel="noopener"
            aria-label="RSS Feed"
            class="p-2 rounded-lg text-gray-400 hover:text-primary dark:hover:text-primary hover:bg-primary/10 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
          </a>
        </div>
        <a
          href="mailto:contato@tonacorreria.com.br"
          class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary transition-colors"
        >
          contato@tonacorreria.com.br
        </a>
      </div>
    </div>

    <div class="border-t border-gray-100 dark:border-gray-800 pt-6 text-center">
      <p class="text-sm text-gray-400 dark:text-gray-500">
        © 2021–{year} Tô na Correria Podcast. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>
