---
import Layout from '../layouts/Layout.astro';
import { events } from '../data/events';

const now = new Date('2026-05-10');

const distanceIcons: Record<string, string> = {
  '10km': '🏃',
  '10 milhas (16km)': '🏃',
  'Meia Maratona': '🥈',
  'Maratona + Meia Maratona': '🏆',
};

function isPast(dateISO: string) {
  return new Date(dateISO) < now;
}

function daysUntil(dateISO: string) {
  const diff = new Date(dateISO).getTime() - now.getTime();
  return Math.ceil(diff / (1000 * 60 * 60 * 24));
}
---

<Layout
  title="Eventos"
  description="Calendário de corridas de rua em Austin, Texas — Cap10k, Run for the Water, Austin Marathon e mais."
>

  <!-- Page Hero -->
  <section class="relative overflow-hidden py-20 bg-gradient-to-br from-[#1a0a0a] via-[#2d0d0d] to-[#1a1a2e]">
    <div
      class="absolute top-0 right-0 w-80 h-80 rounded-full opacity-10 pointer-events-none hero-orb"
      style="background: radial-gradient(circle, #E8421A, transparent 70%)"
      aria-hidden="true"
    ></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1
        class="font-display font-extrabold text-4xl md:text-5xl text-white mb-4"
        style="text-shadow: 0 4px 24px rgba(232,66,26,0.5)"
      >
        Agenda de <span class="text-primary">Corridas</span>
      </h1>
      <p class="text-gray-300 text-lg">Austin, Texas — corridas que a gente corre (e recomenda)</p>
    </div>
  </section>

  <!-- Events -->
  <section class="py-16 bg-white dark:bg-[#121212] transition-colors">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="space-y-6">
        {events.map(event => {
          const past = isPast(event.dateISO);
          const days = daysUntil(event.dateISO);
          const icon = distanceIcons[event.distance] ?? '🏁';

          return (
            <article class:list={[
              'rounded-2xl overflow-hidden border transition-all duration-200',
              past
                ? 'opacity-60 border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-[#1A1A1A]'
                : 'border-gray-100 dark:border-gray-800 bg-white dark:bg-[#1E1E1E] shadow-card dark:shadow-card-dark hover:shadow-card-hover hover:-translate-y-0.5',
            ]}>
              <div class="flex flex-col sm:flex-row sm:items-center gap-4 p-6">

                <!-- Icon + date -->
                <div class="flex-shrink-0 flex flex-col items-center justify-center w-20 h-20 rounded-2xl bg-primary/10 dark:bg-primary/20 text-center">
                  <span class="text-2xl leading-none">{icon}</span>
                  <span class="text-[10px] font-semibold text-primary mt-1 leading-tight text-center px-1">
                    {event.distance}
                  </span>
                </div>

                <!-- Info -->
                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2 flex-wrap">
                    <div>
                      <h2 class="font-display font-bold text-xl text-gray-900 dark:text-white">{event.name}</h2>
                      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
                        📅 {event.date} &nbsp;·&nbsp; 📍 {event.location}
                      </p>
                    </div>
                    {!past && (
                      <div class="flex-shrink-0 text-center">
                        <div class="countdown-digit" data-date={event.dateISO}>
                          {days}
                        </div>
                        <div class="text-xs text-gray-400 dark:text-gray-500">dias</div>
                      </div>
                    )}
                    {past && (
                      <span class="flex-shrink-0 text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-200 dark:bg-gray-700 text-gray-500 dark:text-gray-400">
                        Encerrado
                      </span>
                    )}
                  </div>
                </div>

                <!-- CTA -->
                {!past && (
                  <div class="flex-shrink-0">
                    <a
                      href={event.url}
                      target="_blank"
                      rel="noopener"
                      class="btn-primary text-sm px-5 py-2.5"
                    >
                      Inscrever-se
                    </a>
                  </div>
                )}

              </div>
            </article>
          );
        })}
      </div>

    </div>
  </section>

</Layout>

<script>
  // Live countdown update
  document.querySelectorAll<HTMLElement>('.countdown-digit[data-date]').forEach(el => {
    const target = new Date(el.dataset.date!);
    function update() {
      const diff = target.getTime() - Date.now();
      const days = Math.max(0, Math.ceil(diff / 86400000));
      el.textContent = String(days);
    }
    update();
    setInterval(update, 60_000);
  });
</script>
